# graphical-session.target is the only session target left: uwsm starts it for both
# compositors, which is what retired the hand-rolled sway-session.target this used to be
# bound to.
# NOTE: this file is a local copy, not a symlink into ~/.linux-config like mako/playerctld.
[Unit]
Description=Dynamic output configuration for Wayland compositors
Documentation=https://github.com/emersion/kanshi
BindsTo=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/kanshi
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
