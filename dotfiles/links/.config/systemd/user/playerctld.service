# playerctld remembers which mpris service was most recently active and ensure that commands
# are routed to that player
# Bound to graphical-session.target rather than sway-session.target so this starts under
# both compositors: sway-session.target has BindsTo=graphical-session.target (so it pulls
# it in), and uwsm starts graphical-session.target natively for Hyprland.
[Unit]
BindsTo=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/playerctld
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
