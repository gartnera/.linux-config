# playerctld remembers which mpris service was most recently active and ensure that commands
# are routed to that player
# graphical-session.target is the only session target left: uwsm starts it for both
# compositors, which is what retired the hand-rolled sway-session.target this used to be
# bound to.
[Unit]
BindsTo=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/playerctld
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
